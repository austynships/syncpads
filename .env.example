# Copy to .env for local development:  cp .env.example .env
# In production, set these in Coolify's Environment Variables, never in the repo.

# --- App ---
# Public URL of the app (no trailing slash). Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000
# Random secret, at least 32 characters. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# --- Database (MariaDB 11.8) ---
# Matches docker-compose.yml for local dev. Format: mysql://user:password@host:3306/database
DATABASE_URL=mysql://syncpads:syncpads@localhost:3306/syncpads
# Optional: separate database for the account deletion test (created by docker-compose)
TEST_DATABASE_URL=mysql://syncpads:syncpads@localhost:3306/syncpads_test

# --- Redis (sign-in lockout counters; job queues in later phases) ---
REDIS_URL=redis://localhost:6379

# --- Email (Resend) ---
# Leave empty in development to print emails to the terminal instead.
# Required in production.
RESEND_API_KEY=
# Sender address; its domain must be verified in Resend.
EMAIL_FROM=SyncPads <no-reply@syncpads.com>

# --- Proxy ---
# "true" only when running behind a reverse proxy that sets X-Forwarded-For
# (Coolify's Traefik/Caddy). The Docker image sets this to true by default.
TRUST_PROXY=false

# --- Migrations ---
# "true" applies pending migrations when the server starts (default in the Docker image).
# Locally, run `npm run db:migrate` instead.
RUN_MIGRATIONS_ON_START=false

