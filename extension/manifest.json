{
  "manifest_version": 3,
  "name": "SyncPads",
  "version": "0.1.0",
  "description": "Your SyncPads start page on every new tab. Save pages and tabs, and import your Chrome bookmarks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to SyncPads",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["tabs", "bookmarks", "storage"],
  "host_permissions": ["https://syncpad.tech/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to SyncPads"
    }
  }
}
