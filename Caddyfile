# Caddy gets and renews the HTTPS certificate for APP_DOMAIN automatically.
# It also sets X-Forwarded-For to the real client IP (ignoring any value the
# client sent), which the sign-in lockout relies on.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# www.<domain> -> <domain>. Needs a www DNS record pointing at this server.
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

