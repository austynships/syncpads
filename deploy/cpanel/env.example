# Settings for SyncPads on the cPanel server.
# Lives at /home/<user>/syncpads/.env (readable only by that user). Never commit it.
# PORT, HOSTNAME, TRUST_PROXY and RUN_MIGRATIONS_ON_START are set in syncpads.service.

BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_SECRET=

# cPanel prefixes database names and users with the account name, e.g. syncpads_main
DATABASE_URL=mysql://USER_dbuser:PASSWORD@localhost:3306/USER_dbname
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379

RESEND_API_KEY=
EMAIL_FROM=SyncPads <no-reply@example.com>
