# Server settings for docker-compose.prod.yml.
# On the server:  cp .env.production.example .env  then fill in every value.
# Never commit the real .env.

# Your app's domain, no https:// and no trailing slash. Its DNS A record must point to this server.
APP_DOMAIN=app.example.com

# Generate each of these on the server with:  openssl rand -hex 32
BETTER_AUTH_SECRET=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# Resend (resend.com): API key, and a sender on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=SyncPads <no-reply@example.com>

# Optional: smart features (Phase 4). Without these, links still get titles and
# keyword search; summaries/tags and search by meaning stay off. Users also have
# to turn smart features on in Settings before any page text is sent.
#   Anthropic (summaries and tags): https://console.anthropic.com
#   Voyage AI (search by meaning): https://dash.voyageai.com
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# ENRICH_MODEL=claude-haiku-5-5

# Plans and billing (Stripe). Without the secret key, upgrades show "Coming soon".
# STRIPE_WEBHOOK_SECRET is written by the setup script (see README "Billing").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard at /admin: comma-separated emails. Each account must have a verified email.
# Everyone else gets a 404 there.
ADMIN_EMAILS=

# Optional: nightly database backups (scripts/backup.sh). Defaults shown.
# BACKUP_DIR=/var/backups/syncpads
# BACKUP_KEEP_DAYS=14

